###### ------ ARQ & ENV ------ ######
{% if scale_asterisk is defined and scale_asterisk %}
SCALE=True
MEM_LIMIT={{ asterisk_mem_limit | default("1G", true) }}
THREADPOOL_IDLE_TIMEOUT={{ pjsip_threadpool_idle_timeout | default(60, true) }}
THREADPOOL_MAX_SIZE={{ pjsip_threadpool_max_size | default(25, true) }}
THREADPOOL_INITIAL_SIZE={{ pjsip_threadpool_initial_size | default(8, true) }}
THREADPOOL_AUTO_INCREMENT={{ pjsip_threadpool_auto_increment | default(5, true) }}
STASIS_INITIAL_SIZE={{ stasis_initial_size | default(10, true) }}
STASIS_IDLE_TIMEOUT_SEC={{ stasis_idle_timeout_sec | default(8, true) }}
STASIS_MAX_SIZE={{ stasis_max_size | default(60, true) }}
TIMER_T1={{ pjsip_timer_t1 | default(100), true }}
TIMER_B={{ pjsip_timer_b | default(6400, true) }}
{% else %}
SCALE=false
{% endif %}
{% if inventory_hostname in groups['omnileads_voice'] %}
ARQ=cluster
{% elif inventory_hostname in groups['omnileads_aio'] %}
ARQ=aio
{% endif %}
{% if omnileads_ha is defined %}
ENV=ha
ASTERISK_VIP={{ omnileads_vip }}
{% else %}
ENV={{ infra_env }}
{% endif %}
TENANT_ID={{ tenant_id }}
TZ={{ TZ }}
{% if postgres_utc == false %}
UTC_LOGS=False
{% else %}
UTC_LOGS=True
{% endif %}
{% if nat_ip_addr is defined %}
PUBLIC_IP={{ nat_ip_addr }}
{% endif %}
###### ------ HOSTs ------ ######
ASTERISK_PUBLIC_IP={{ omni_ip_wan }}
ASTERISK_HOSTNAME={{ omni_ip_lan }}
DIALER_HOST={{ dialer_host | default("127.0.0.1", true)}}
FASTAGI={{ fastagi_host }}
GEARMAN_HOST={{ gearman_host }}
HOSTNAME={{ omni_ip_lan }}
PUBLIC_IP={{ omni_ip_wan }}
OMNILEADS_HOSTNAME={{ nginx_host }}
{% if homer_host is defined %}
HOMER_ENABLE=True
HOMER_HOST={{ homer_host }}
HOMER_PORT=9060
{% else %}
HOMER_ENABLE=false
{% endif %}
ASTERISK_LOCATION=
AMI_USER={{ ami_user }}
AMI_PASSWORD={{ ami_password }}

{% if callrec_transcriptions is defined and callrec_transcriptions %}
CALLREC_SPLIT_CHANNELS=True
{% else %}
CALLREC_SPLIT_CHANNELS=false
{% endif %}

##### --- RTP Ports ---- ####
RTP_PORT_MIN={{ acd_rtp_port_min | default(40000, true) }}
RTP_PORT_MAX={{ acd_rtp_port_max | default(50000, true) }}

{% if acd_log_level is defined %}
{% if acd_log_level  == 0 %}
ACD_LOGLEVEL=error
{% elif acd_log_level  == 1 %}
ACD_LOGLEVEL=warning
{% elif acd_log_level  == 2 %}
ACD_LOGLEVEL=verbose
{% elif acd_log_level  == 3 %}
ACD_LOGLEVEL=debug
{% endif %}
{% endif %}