# --- OMnidialer container images
API_IMG={{ dialer_api_image }}
LISTENER_IMG={{ dialer_listener_image }}}
WORKER_IMG={{ dialer_worker_image }}
SCHEDULER_IMG={{ dialer_scheduler_image }}
DIALPLAN_IMG={{ dialer_dialplan_image }}
ASTERISK_IMG={{ dialer_asterisk_image }}
# --- 3rd party container images
POSTGRES_IMG={{ postgres_image }}
GEARMAN_IMG={{ gearman_image }}
REDIS_IMG={{ redis_image }}

# --- Time Zone
TZ={{ timezone }}

# --- Asterisk dialer container params
ASTERISK_USER={{ ami_user }}
ASTERISK_PASS={{ ami_password }}
ASTERISK_HOST={{ omni_ip_lan }}
ASTERISK_PORT={{ asterisk_ari_port }}
ASTERISK_APP_DIALER=call_manager_dialer
ASTERISK_APP=call_manager
# --- Asterisk dialer IPV4 container or NAT ADDR
ASTERISK_CONTAINER_ADDR={{ omni_ip_lan }}

# --- Redis OML & dialer conn params
REDIS_OML_SERVER={{ redis_host }}
REDIS_OML_PORT={{ redis_port }}
REDIS_DIALER_SERVER={{ redis_host }}
REDIS_DIALER_PORT={{ redis_port }}
REDIS_DB=3

# --- Postgres OML & dialer conn params
POSTGRES_OML_USER={{ postgres_user }}
POSTGRES_OML_PASSWORD={{ postgres_password }}
POSTGRES_OML_SERVER={{ postgres_host }}
POSTGRES_OML_PORT={{ postgres_port }}
POSTGRES_OML_DB={{ postgres_database }}

POSTGRES_DIALER_USER=omnidialer
POSTGRES_DIALER_PASSWORD=dialer456
POSTGRES_DIALER_SERVER=postgresql
POSTGRES_DIALER_PORT=5433
POSTGRES_DIALER_DB=omnidialer

# --- RabbitMQ OML conn params
RABBITMQ_OML_SERVER={{ rabbitmq_host }}

# --- Gearman conn params
GEARMAN_JOB_SERVERS=gearman_server:4730
GEARMAN_JOBS=start-campaign|stop-campaign|resume-campaign|process-contact|schedule-contact|process-event|create-campaign|edit-campaign|pause-campaign|delete-campaign|send-reports|add-incidence-rule-disposition|create-incidence-rule|process-campaign

DIALER_ACD_HOST=pstn_gateway

# --- Log level
PYTHON_LOGLEVEL=debug

# --- OMniLeads ACD SIP Peer when dialer send calls
OMLACD_SIP_ADDR={{ acd_host }}:{{ acd_sip_port }}

# --- Call attempts per second
CAPS=1

# --- Workers replicas
WORKER_REPLICAS={{ dialer_worker_replicas }}

# --- Network docker name
NETWORK=oml_omnileads

# --- Dial through PSTN Gateway settings
# --- In order to use this feature, you must have a PSTN Gateway configured 
# --- with SIP registration and authentication enabled.

# PSTNGW_REGISTER={{ pstn_register }}
# PSTNGW_SIP_AUTH={{ pstn_sip_auth }}
# PSTNGW_SIP_USER={{ pstn_sip_user }}
# PSTNGW_SIP_PASS={{ pstn_sip_password }}
# PSTNGW_HOSTNAME={{ pstn_host_sip_addr }}:{{ pstn_host_sip_port }}
