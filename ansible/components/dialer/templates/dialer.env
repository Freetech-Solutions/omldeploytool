TZ={{ TZ }}

ASTERISK_SIP_ADDR=127.0.0.1

ASTERISK_USER={{ ami_user }}
ASTERISK_PASS={{ ami_password }}
ASTERISK_HOST={{ omni_ip_lan }}
ASTERISK_PORT=8888
ASTERISK_APP_DIALER=call_manager_dialer
ASTERISK_APP=call_manager
REDIS_OML_SERVER={{ redis_host }}
REDIS_OML_PORT={{ redis_port }}
REDIS_DIALER_SERVER={{ redis_host }}
REDIS_DIALER_PORT={{ redis_port }}
REDIS_DB=3
POSTGRES_OML_USER={{ postgres_user }}
POSTGRES_OML_PASSWORD={{ postgres_password }}
POSTGRES_OML_SERVER={{ postgres_host }}
POSTGRES_OML_PORT={{ postgres_port }}
POSTGRES_OML_DB={{ postgres_database }}
POSTGRES_DIALER_USER=omnidialer
POSTGRES_DIALER_PASSWORD={{ postgres_password }}
POSTGRES_DIALER_SERVER={{ omni_ip_lan }}
POSTGRES_DIALER_DB=omnidialer
POSTGRES_DIALER_PORT=5433
POSTGRES_DB=omnidialer
POSTGRES_USER=omnidialer
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_PORT=5432
POSTGRES_DB=omnidialer
GEARMAN_JOB_SERVERS={{ gearman_host }}:4730
DIALER_ACD_HOST=pstn_gateway
WEBSOCKET_SERVER="wss://127.0.0.1/channels/omnidialer"
OMLACD_SIP_SERVER={{ omlacd_dialer_host }}:5260
CAPS={{ dialer_caps }}
OMNIDIALER_SUBNET=10.72.0.0/24
GEARMAN_JOBS="start-campaign|stop-campaign|resume-campaign|process-contact|schedule-contact|process-event|create-campaign|edit-campaign|pause-campaign|delete-campaign|send-reports|add-incidence-rule-disposition|create-incidence-rule|process-campaign"
SCHEDULER_API_HOST=dialer-scheduler-api:1441

{% if dialer_passthrough_dial_out is defined and dialer_passthrough_dial_out %}
PSTNGW_HOSTNAME={{ dialer_trunk_hostname }}
{% if dialer_trunk_auth_enable is defined and dialer_trunk_auth_enable %}
PSTNGW_SIP_AUTH=yes
PSTNGW_SIP_USER={{ dialer_trunk_username }}
PSTNGW_SIP_PASS={{ dialer_trunk_password }}
{% endif %}
{% endif %}

{% if dialer_log_level is defined %}
{% if dialer_log_level  == 0 %}
PYTHON_LOGLEVEL=error
{% elif dialer_log_level  == 1 %}
PYTHON_LOGLEVEL=warning
{% elif dialer_log_level  == 2 %}
PYTHON_LOGLEVEL=debug
{% endif %}
{% endif %}