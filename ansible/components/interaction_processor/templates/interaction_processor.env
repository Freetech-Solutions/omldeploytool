# Variables fundamentales
TZ={{ TZ }}
GEARMAN_HOST={{ gearman_host }}
S3_BUCKET_NAME={{ bucket_name }}

# Credenciales AWS (se aplican en todas las ramas)
AWS_ACCESS_KEY_ID={{ bucket_access_key }}
AWS_SECRET_ACCESS_KEY={{ bucket_secret_key }}

{# Configuración de S3 según endpoint #}
{% if bucket_url is not defined %}
# Usar MinIO local
S3_ENDPOINT={{ minio_host }}
AWS_DEFAULT_REGION=us-east-1
CALLREC_DEVICE=s3

{% elif bucket_url == 'aws' %}
# Usar AWS S3
S3_ENDPOINT_AWS=
AWS_DEFAULT_REGION={{ bucket_region }}
CALLREC_DEVICE=s3-aws

{% else %}
# Endpoint personalizado
S3_ENDPOINT={{ bucket_url }}
AWS_DEFAULT_REGION=us-east-1
CALLREC_DEVICE={{ 's3-no-check-cert' if bucket_ssl_selfsigned is defined and bucket_access_key else 's3' }}
{% endif %}

{# Transcripciones (STT) opcionales #}
{% if callrec_transcriptions is defined and callrec_transcriptions %}
STT_ENGINE={{ callrec_transcriptions_engine }}
{% if callrec_transcriptions_engine != 'local' %}
STT_API_KEY={{ callrec_transcriber_api_key }}
{% endif %}
{% endif %}
