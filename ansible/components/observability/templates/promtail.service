# Promtail Systemd Service Template
# Generated by Ansible for {{ inventory_hostname }}
# Tenant: {{ tenant_id }}

[Unit]
Description=Promtail service - Log aggregator for {{ tenant_id }}
Documentation=https://grafana.com/docs/loki/latest/clients/promtail/
After=network-online.target
Wants=network-online.target
RequiresMountsFor=%t/containers

[Service]
Type=notify
NotifyAccess=all
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
RestartSec=30
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%n.ctr-id

# Main Promtail container
ExecStart=/usr/bin/podman run \
  --cpus=1 \
  --cpu-shares=512 \
  --cidfile=%t/%n.ctr-id \
  --cgroups=no-conmon \
  --sdnotify=conmon \
  --replace \
  --detach \
  --network=host \
  --log-driver=journald \
  --name=promtail-server \
  --rm \
  --volume=/etc/default/promtail.yml:/etc/promtail/config.yml:ro \
  --volume=promtail_data:/tmp \
  --volume=/run/log/journal/:/var/log/journal/:ro \
  --volume=/etc/machine-id:/etc/machine-id:ro \
  --volume=/var/log:/var/log:ro \
  --label="tenant={{ tenant_id }}" \
  --label="service=promtail" \
  --label="node_type={{ 'aio' if inventory_hostname in groups['omnileads_aio'] else 'app' if inventory_hostname in groups['omnileads_app'] else 'voice' if inventory_hostname in groups['omnileads_voice'] else 'data' if inventory_hostname in groups['omnileads_data'] else 'dialer' }}" \
  {{ promtail_img }} \
  -config.file=/etc/promtail/config.yml \
  -config.expand-env=true

ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore --cidfile=%t/%n.ctr-id

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=promtail

# Security and resource limits
MemoryLimit={{ promtail_memory_limit | default('512M') }}
CPUQuota={{ promtail_cpu_quota | default('50%') }}

[Install]
WantedBy=multi-user.target