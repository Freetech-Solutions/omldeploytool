# Add extra options here
RTPENGINE_HOSTNAME={{ omni_ip_lan }}
{% if infra_env == "ha" %}
ENV=lan
{% else %}
ENV={{ infra_env }}
{% endif %}
{% if nat_ip_addr is defined %}
PUBLIC_IP={{ nat_ip_addr }}
{% endif %}

TIMEOUT={{ rtpengine_timeout | default(15, true) }}
OFFER_TIMEOUT={{ rtpengine_offer_timeout | default(30, true) }}
SILENT_TIMEOUT={{ rtpengine_silent_timeout | default(60, true) }}
FINAL_TIMEOUT={{ rtpengine_final_timeout | default(3600, true) }}
RTP_PORT_MIN={{ rtpengine_rtp_port_min | default(20000, true) }}
RTP_PORT_MAX={{ rtpengine_rtp_port_max | default(30000, true) }}
LOG_LEVEL={{ log_level | default(4, true) }}