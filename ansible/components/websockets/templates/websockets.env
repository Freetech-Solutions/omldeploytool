EVENT_LOOP=uvloop
LOGGERS=DEBUG:fts.oml.services.websockets;INFO:websockets.server
DEBUG_EVENT_LOOP=off
BIND_ADDRESS={{ websockets_host }}:8000
REDIS_HOST=redis://{{ redis_host }}
DJANGO_HOSTNAME=127.0.0.1
DJANGO_PORT={{ uwsgi_port }}
WS_ALLOWED_ORIGINS=https://{{ nginx_host }}{% if omni_ip_wan is defined and omni_ip_wan %},https://{{ omni_ip_wan }}{% endif %}{% if fqdn is defined and fqdn %},https://{{ fqdn }}{% endif %}

WS_ACD_SECRET={{ ws_acd_secret }}
