ACD_WEBHOOK_TRANSFER_TTL={{ acd_ag_handoff_ttl }}
ARI_URL=http://127.0.0.1:{{ acd_ari_port }}
ARI_USER={{ ami_user }}
ARI_PASSWORD={{ ami_password }}
ARI_PASS={{ ami_password }}
ARI_APP={{ acd_app }}
BUCKET_ACCESS_KEY_ID={{ bucket_access_key }}
BUCKET_SECRET_ACCESS_KEY={{ bucket_secret_key }}
BUCKET_NAME={{ bucket_name }}
BUCKET_ENDPOINT={{ bucket_endpoint_internal }}
GEARMAN_SERVERS={{ gearman_host  | trim }}:{{ gearman_port }}
NODE_ID={{ acd_host }}
OMNILEADS_HOSTNAME={{ nginx_host | trim }}
OMNILEADS_PROTOCO=https
OMNILEADS_VERIFY_SSL=false
PROMETHEUS_METRICS_PORT={{ acd_app_metrics_port | default(7098) }}
PYTHON_LOGLEVEL={{ acd_log_level }}
SIP_PROXY={{ omni_ip_lan }}:{{ kamailio_pstn_port }}
# SIP_EXTRA_HEADERS=""
REDIS_URL=redis://{{ redis_host | trim }}:{{ redis_port }}
REDIS_HOST={{ redis_host | trim }}
RECORDING_BASE_PATH=/var/spool/asterisk/recording
TENANT_ID={{ tenant_id }}
TZ={{ TZ }}
WEBRTC_TRUNK=webrtc-trunk
{% if voicebot_headers_vars is defined %}
SIP_EXTRA_HEADERS={{ voicebot_headers_vars }}
{% endif %}