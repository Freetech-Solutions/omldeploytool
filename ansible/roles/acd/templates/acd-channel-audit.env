ARI_URL=http://{{ omni_ip_lan }}:{{ acd_ari_port }}
ARI_USER={{ ami_user }}
ARI_PASSWORD={{ ami_password }}
ARI_APP={{ acd_app }}
REDIS_URL=redis://{{ redis_host | trim }}:{{ redis_port }}
ACD_AUDIT_NODE_ID={{ omni_ip_lan }}
ACD_CHANNEL_AUDIT_INTERVAL_SEC={{ acd_channel_audit_interval_sec | default(15) }}
ACD_CHANNEL_AUDIT_HB_TTL_SEC={{ acd_channel_audit_hb_ttl_sec | default(45) }}
PYTHON_LOGLEVEL={{ acd_log_level }}
TZ={{ TZ }}
