ASTERISK_APP={{ acd_app }}
AMI_USER={{ ami_user }}
AMI_PASSWORD={{ ami_password }}
FASTAGI=127.0.0.1
{% if homer_host is defined %}
HOMER_ENABLE=False
HOMER_HOST={{ homer_host }}
HOMER_PORT={{ homer_port }}
{% else %}
HOMER_ENABLE=false
{% endif %}
LOG_LEVEL={{ log_level | default(0, true) }}
RTP_PORT_MIN={{ acd_rtp_port_min | default(40000, true) }}
RTP_PORT_MAX={{ acd_rtp_port_max | default(50000, true) }}
{% if scale_asterisk is defined and scale_asterisk %}
SCALE=True
MEM_LIMIT={{ asterisk_mem_limit | default("1G", true) }}
THREADPOOL_IDLE_TIMEOUT={{ pjsip_threadpool_idle_timeout | default(60, true) }}
THREADPOOL_MAX_SIZE={{ pjsip_threadpool_max_size | default(25, true) }}
THREADPOOL_INITIAL_SIZE={{ pjsip_threadpool_initial_size | default(8, true) }}
THREADPOOL_AUTO_INCREMENT={{ pjsip_threadpool_auto_increment | default(5, true) }}
STASIS_INITIAL_SIZE={{ stasis_initial_size | default(10, true) }}
STASIS_IDLE_TIMEOUT_SEC={{ stasis_idle_timeout_sec | default(8, true) }}
STASIS_MAX_SIZE={{ stasis_max_size | default(60, true) }}
TIMER_T1={{ pjsip_timer_t1 | default(100, true) }}
TIMER_B={{ pjsip_timer_b | default(6400, true) }}
{% else %}
SCALE=false
{% endif %}
VOIP_PROXY_HOSTNAME={{ kamailio_pstn_host | default(omni_ip_lan, true) }}
VOIP_PROXY_PORT={{ kamailio_pstn_port | default(5060, true) }}
TENANT_ID={{ tenant_id }}
TZ={{ TZ }}
WEBRTC_PROXY_HOSTNAME={{ kamailio_host }}
WEBRTC_PROXY_PORT={{ kamailio_webrtc_udp_port | default(10060, true) }}