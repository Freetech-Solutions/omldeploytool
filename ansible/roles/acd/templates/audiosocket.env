AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT={{ audiosocket_port }}
VOICEBOT_VENDOR={{ voicebot_vendor | default('ces') }}
REDIS_HOST={{ redis_host | trim }}
REDIS_PORT={{ redis_port }}
REDIS_DB={{ audiosocket_redis_db | default(0) }}
{% if (audiosocket_gcp_project_id | default('') | string | length) > 0 %}
PROJECT_ID={{ audiosocket_gcp_project_id }}
{% endif %}
LOCATION={{ audiosocket_gcp_location | default('us') }}
APP_ID={{ audiosocket_gcp_app_id | default('', true) }}
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
OML_API_BASE_URL=https://{{ oml_omnileads_hostname | default(edge_host | default(nginx_host) | trim) }}
OML_API_VERIFY_SSL=false
OML_VOICEBOT_USERNAME={{ voicebot_username | default('', true) }}
OML_VOICEBOT_PASSWORD={{ voicebot_password | default('', true) }}
AUDIOSOCKET_DEBUG_PII={{ audiosocket_debug_pii | default('', true) }}
TZ={{ TZ }}
