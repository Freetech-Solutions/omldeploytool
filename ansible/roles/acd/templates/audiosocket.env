AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT={{ audiosocket_port }}
VOICEBOT_VENDOR={{ voicebot_vendor | default('ces') }}
REDIS_HOST={{ redis_host | trim }}
REDIS_PORT={{ redis_port }}
REDIS_DB={{ audiosocket_redis_db | default(0) }}
{% if (audiosocket_gcp_project_id | default('') | string | length) > 0 %}
PROJECT_ID={{ audiosocket_gcp_project_id }}
{% endif %}
LOCATION={{ audiosocket_gcp_location | default('us') }}
APP_ID={{ audiosocket_gcp_app_id | default('', true) }}
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
# Auth CES: bearer file/env tiene precedencia sobre AUTH_MODE=jwt y el JSON montado.
# AUDIOSOCKET_GCP_CREDENTIALS_JSON debe ser Base64 de una sola línea (sin comillas).
AUDIOSOCKET_GCP_AUTH_MODE={{ audiosocket_gcp_auth_mode | default('auto') }}
AUDIOSOCKET_GCP_SCOPE={{ audiosocket_gcp_scope | default('cloud-platform') }}
AUDIOSOCKET_GCP_JWT_AUDIENCE={{ audiosocket_gcp_jwt_audience | default('https://ces.googleapis.com/') }}
{% if (audiosocket_gcp_credentials_json | default('') | string | trim | length) > 0 %}
AUDIOSOCKET_GCP_CREDENTIALS_JSON={{ audiosocket_gcp_credentials_json | trim }}
{% endif %}
{% if (audiosocket_gcp_bearer_token | default('') | string | trim | length) > 0 %}
AUDIOSOCKET_GCP_BEARER_TOKEN={{ audiosocket_gcp_bearer_token | trim }}
{% endif %}
{% if (audiosocket_gcp_bearer_token_file | default('') | string | trim | length) > 0 %}
AUDIOSOCKET_GCP_BEARER_TOKEN_FILE={{ audiosocket_gcp_bearer_token_file | trim }}
{% endif %}
{% if (audiosocket_gcp_impersonate_sa | default('') | string | trim | length) > 0 %}
AUDIOSOCKET_GCP_IMPERSONATE_SERVICE_ACCOUNT={{ audiosocket_gcp_impersonate_sa | trim }}
{% endif %}
OML_API_BASE_URL=https://{{ oml_omnileads_hostname | default(edge_host | default(nginx_host) | trim) }}
OML_API_VERIFY_SSL=false
OML_VOICEBOT_USERNAME={{ voicebot_username | default('', true) }}
OML_VOICEBOT_PASSWORD={{ voicebot_password | default('', true) }}
AUDIOSOCKET_DEBUG_PII={{ audiosocket_debug_pii | default('', true) }}
TZ={{ TZ }}
