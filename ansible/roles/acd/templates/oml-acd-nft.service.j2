[Unit]
Description=OMniLeads ACD nftables allowlist (ARI/metrics/SIP/RTP)
Documentation=https://docs.omnileads.net/
DefaultDependencies=no
After=network-pre.target
Before={{ acd_pod_systemd_unit | default('acd-pod.service') }}
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ acd_nftables_rules_path | default('/etc/omnileads/oml-acd.nft') }}
# On stop, remove only this table (leave netavark / fail2ban alone).
# Leading "-" ignores failure if the table is already gone.
ExecStop=-/usr/sbin/nft delete table inet oml_acd

[Install]
WantedBy=multi-user.target
