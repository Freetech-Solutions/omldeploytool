[Unit]
Description=OMniLeads Bulk Messages Worker
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=oml-bulk-messages-worker
Image={{ APP_IMG }}
Pod=enterprise.pod
EnvironmentFile=/etc/default/django.env
Environment=GOOGLE_MAPS_CENTER={{ google_maps_center }}
Label=tier=enterprise
LogDriver=journald
PodmanArgs=--cgroups=no-conmon
Exec=python /opt/omnileads/ominicontacto/manage.py ejecutar_ordenes_de_envio

[Service]
Restart=on-failure
RestartSec=60
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
