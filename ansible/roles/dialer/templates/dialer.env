# Identidad HA (leader lease SchedulerWorker, locks). Por host = inventory_hostname.
OML_NODE_ID={{ inventory_hostname }}

{% if dialer_log_level is defined %}
{% if dialer_log_level  == 0 %}
PYTHON_LOGLEVEL=error
{% elif dialer_log_level  == 1 %}
PYTHON_LOGLEVEL=warning
{% elif dialer_log_level  == 2 %}
PYTHON_LOGLEVEL=debug
{% endif %}
{% endif %}

TZ={{ TZ }}

REDIS_OML_SERVER={{ redis_host | trim }}
REDIS_OML_PORT={{ redis_port }}
REDIS_DIALER_SERVER={{ redis_host | trim }}
REDIS_DIALER_PORT={{ redis_port }}
REDIS_DB=3

POSTGRES_OML_USER={{ postgres_user }}
POSTGRES_OML_PASSWORD={{ postgres_password }}
POSTGRES_OML_SERVER={{ postgres_host  | trim }}
POSTGRES_OML_PORT={{ postgres_port }}
POSTGRES_OML_DB={{ postgres_database }}
POSTGRES_DIALER_USER={{ postgres_user }}
POSTGRES_DIALER_PASSWORD={{ postgres_password }}
POSTGRES_DIALER_SERVER={{ postgres_host  | trim }}
POSTGRES_DIALER_DB=omnidialer
POSTGRES_DIALER_PORT={{ postgres_port }}

GEARMAN_JOB_SERVERS={{ gearman_host  | trim }}:4730
WEBSOCKET_SERVER="wss://nginx-server/channels/omnidialer"
GEARMAN_JOBS="start-campaign|stop-campaign|resume-campaign|process-contact|schedule-contact|process-event|create-campaign|edit-campaign|pause-campaign|delete-campaign|send-reports|add-incidence-rule-disposition|create-incidence-rule|process-campaign"

CAPS={{ dialer_caps }}
TIME_BETWEEN_CALLS={{ dialer_time_between_calls | default(1) }}
DIALER_CHANNEL_AUDIT_INTERVAL_SEC={{ dialer_channel_audit_interval_sec | default(60) }}
DIALER_CHANNEL_AUDIT_LOCK_TTL_SEC={{ dialer_channel_audit_lock_ttl_sec | default(55) }}
DIALER_RESERVE_GRACE_SEC={{ dialer_reserve_grace_sec | default(30) }}
DIALER_MAX_ABANDON_RATE={{ dialer_max_abandon_rate | default(0.05) }}
DIALER_WARM_UP_SAMPLE_SIZE={{ dialer_warm_up_sample_size | default(50) }}
DIALER_PREDICTIVE_TICK_MS={{ dialer_predictive_tick_ms | default(1000) }}
DIALER_HIT_RATE_FLOOR={{ dialer_hit_rate_floor | default(0.03) }}
DIALER_DROP_RATE_ALPHA={{ dialer_drop_rate_alpha | default(0.15) }}
DIALER_DEFAULT_ART_SEC={{ dialer_default_art_sec | default(15) }}
DIALER_P_LIB_REMAINING_EPS={{ dialer_p_lib_remaining_eps | default(1.0) }}
DIALER_PREDICTIVE_ENABLED={{ dialer_predictive_enabled | default('true') }}
DIALER_GAMMA_THROTTLE_FLOOR={{ dialer_gamma_throttle_floor | default(0.3) }}

# P0 origin guardrails (abort CAPS batch on event backlog / CALLS−Ast drift)
DIALER_ORIGIN_GUARDRAILS_ENABLED={{ dialer_origin_guardrails_enabled | default('true') }}
DIALER_GUARDRAIL_PROCESS_EVENT_QUEUED_MAX={{ dialer_guardrail_process_event_queued_max | default(100) }}
DIALER_GUARDRAIL_CALLS_AST_DELTA_MAX={{ dialer_guardrail_calls_ast_delta_max | default(15) }}
DIALER_GUARDRAIL_PHASE_CALLS_DELTA_MAX={{ dialer_guardrail_phase_calls_delta_max | default(20) }}
# 0 = disabled. Tenant-wide originates/s across process-campaign workers.
DIALER_GLOBAL_CAPS={{ dialer_global_caps | default(0) }}
DIALER_REQUIRE_ENDPOINTS={{ dialer_require_endpoints | default('false') }}
