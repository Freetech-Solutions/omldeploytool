# Managed by Ansible — OMniLeads fail2ban (SSH + optional Kamailio PSTN + HTTPS).
# Drop-in: no modifica jail.conf de la distro.
# banaction=nftables: prerequisitos desactiva ufw/firewalld.
# backend=systemd: journald (Storage=volatile); no depender de /var/log/auth.log.

[DEFAULT]
ignoreip = {{ fail2ban_ignoreip_list | join(' ') }}
bantime = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
banaction = nftables

[sshd]
enabled = true
port = {{ ansible_ssh_port | default(22) }}
backend = systemd
filter = sshd

{% if fail2ban_deploy_kamailio_pike | default(false) | bool %}
# Kamailio PSTN PIKE / unauthorized origin bans (edge / AIO hosts).
# nftables-allports: drop SIP (UDP/TCP) and all other traffic from banned IPs.
[kamailio-pstn]
enabled = true
filter = kamailio-pike
backend = systemd
journalmatch = _SYSTEMD_UNIT=kamailio_pstn.service
banaction = nftables-allports
protocol = all
{% endif %}

{% if fail2ban_deploy_nginx_https | default(false) | bool %}
# HTTPS probes against nginx (AIO / hosts that terminate TLS without HAProxy).
[nginx-https]
enabled = true
filter = nginx-https
backend = systemd
journalmatch = _SYSTEMD_UNIT=nginx.service
port = http,https
banaction = {{ fail2ban_https_banaction }}
maxretry = {{ fail2ban_https_maxretry }}
findtime = {{ fail2ban_https_findtime }}
bantime = {{ fail2ban_https_bantime }}
{% endif %}

{% if fail2ban_deploy_haproxy_https | default(false) | bool %}
# HTTPS probes against HAProxy (cluster edge — public TLS terminator).
[haproxy-https]
enabled = true
filter = haproxy-https
backend = systemd
journalmatch = _SYSTEMD_UNIT=haproxy.service
port = {{ haproxy_http_port | default(80) }},{{ haproxy_https_port | default(443) }}
banaction = {{ fail2ban_https_banaction }}
maxretry = {{ fail2ban_https_maxretry }}
findtime = {{ fail2ban_https_findtime }}
bantime = {{ fail2ban_https_bantime }}
{% endif %}
