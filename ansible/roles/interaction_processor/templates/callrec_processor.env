# Variables fundamentales
TZ={{ TZ }}
GEARMAN_HOST={{ gearman_host  | trim }}

STT_ENGINE={{ callrec_transcriptions_engine }}
{% if callrec_transcriptions_engine == 'gemini' or callrec_transcriptions_engine == 'openai'%}
STT_API_KEY={{ callrec_transcriber_api_key }}
{% elif callrec_transcriptions_engine == 'gcp'%}
GOOGLE_APPLICATION_CREDENTIALS=/app/google_credentials.json
{% endif %}

BUCKET_ACCESS_KEY_ID={{ bucket_access_key }}
BUCKET_SECRET_ACCESS_KEY={{ bucket_secret_key }}
BUCKET_DEFAULT_REGION={{ bucket_region }}

CALLREC_DEVICE=s3

GEARMAN_HOST={{ gearman_host  | trim }}
S3_BUCKET_NAME={{ bucket_name }}
S3_ENDPOINT={{ bucket_endpoint_internal }}

# Modelo Gemini: si 404, el worker consulta ListModels y prueba modelos disponibles
GEMINI_TRANSCRIPTION_MODEL=gemini-1.5-flash
SUMMARIZE_MODEL:=gemini-1.5-flash
SUMMARIZE_ENGINE=gemini
SUMMARIZE_ENABLED=true
GEMINI_API_KEY={{ callrec_transcriber_api_key }}

PGHOST={{ postgres_host  | trim }}
PGPORT={{ postgres_port }}
PGDATABASE={{ postgres_database }}
PGUSER={{ postgres_user }}
POSTGRES_OML_PASSWORD={{ postgres_password }}

REDIS_HOST={{ redis_host  | trim }}
REDIS_PORT={{ redis_port }}
