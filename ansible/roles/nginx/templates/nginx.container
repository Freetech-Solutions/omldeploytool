# OMniLeads Nginx Quadlet (Podman)

[Unit]
Description=OMniLeads nginx reverse proxy (Podman Quadlet)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
ContainerName=nginx-server
Image={{ NGINX_IMG }}
Pod=omlapp_web.pod
EnvironmentFile=/etc/default/nginx.env
Volume={{ certs_location | default(certs_location) }}:{{ certs_location | default(certs_location) }}
Volume=django_static:/opt/omnileads/static
Volume=django_callrec_zip:/opt/omnileads/asterisk/var/spool/asterisk/monitor
Label=tier=omlapp
LogDriver=journald
PodmanArgs=--cgroups=no-conmon

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target