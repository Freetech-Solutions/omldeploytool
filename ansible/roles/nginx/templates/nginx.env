ASGI_PORT={{ daphne_port }}
ENV=prodenv
DJANGO_HOSTNAME=127.0.0.1
DAPHNE_HOSTNAME=127.0.0.1
KAMAILIO_HOSTNAME={{ kamailio_host | trim }}
KAMAILIO_PORT={{ kamailio_wss_port }}
S3_ENDPOINT={{ bucket_endpoint_internal }}
WEBSOCKETS_HOSTNAME=127.0.0.1
WEBSOCKETS_PORT={{ websocket_port }}
WSGI_PORT={{ uwsgi_port }}
WEBUI_MODE=static
WALLBOARD_WEBUI_PATH=/opt/omnileads/static/webui-wallboard
PREMIUMREPORTS_WEBUI_PATH=/opt/omnileads/static/webui-premiumreports
USE_POD_NETWORK=true
TZ={{ TZ }}
