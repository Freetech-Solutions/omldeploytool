[Unit]
Description=OMniLeads Prometheus dialer pacing exporter (Podman Quadlet)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
ContainerName=obs-prometheus-dialer-pacing
Image={{ DIALER_WORKER_IMG }}
Pod=observability.pod
EnvironmentFile=/etc/default/prometheus_dialer_pacing.env
Exec=python3 omnidialer_metrics.py
PodmanArgs=--cgroups=no-conmon
LogDriver=journald
Label=tier=observability

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
