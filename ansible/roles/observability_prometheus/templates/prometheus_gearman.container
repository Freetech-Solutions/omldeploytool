[Unit]
Description=Podman obs-prometheus-gearman (Quadlet)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
ContainerName=obs-prometheus-gearman
Image={{ GEARMAN_EXPORTER_IMG }}
Pod=observability.pod
Exec=--addr={{ omni_ip_lan }}:9418 --gearmand=127.0.0.1:4730
PodmanArgs=--cgroups=no-conmon
LogDriver=journald
Label=tier=observability

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
