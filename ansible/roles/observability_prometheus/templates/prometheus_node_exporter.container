[Unit]
Description=OMniLeads Prometheus node exporter (Podman Quadlet)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
ContainerName=obs-prometheus-node-exporter
Image={{ PROMETHEUS_NODE_EXPORTER_IMG }}
Network={{ oml_network }}
PublishPort={{ omni_ip_lan }}:{{ prometheus_node_exporter_port | default(9100) }}:{{ prometheus_node_exporter_port | default(9100) }}
User=root
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro
Volume=/:/rootfs:ro,rslave
Exec=--path.procfs=/host/proc --path.sysfs=/host/sys --path.rootfs=/rootfs --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($|/)
PodmanArgs=--cgroups=no-conmon --privileged
LogDriver=journald
Label=tier=observability

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
