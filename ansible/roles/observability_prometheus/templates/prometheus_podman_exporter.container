[Unit]
Description=OMniLeads Prometheus podman exporter (Podman Quadlet)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target podman.socket
After=network-online.target podman.socket
RequiresMountsFor=%t/containers

[Container]
ContainerName=obs-prometheus-podman-exporter
Image={{ PROMETHEUS_PODMAN_IMG }}
Pod=observability.pod
User=root
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Volume=/run/podman/podman.sock:/run/podman/podman.sock
Exec=--collector.enable-all --collector.store_labels --collector.enhance-metrics
PodmanArgs=--cgroups=no-conmon
LogDriver=journald
Label=tier=observability

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
