[Unit]
Description=OMniLeads Prometheus redis exporter (Podman Quadlet)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
ContainerName=obs-prometheus-redis
Image={{ REDIS_EXPORTER_IMG }}
Pod=observability.pod
EnvironmentFile=/etc/default/prometheus_redis.env
PodmanArgs=--cgroups=no-conmon
LogDriver=journald
Label=tier=observability

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
