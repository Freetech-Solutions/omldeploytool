[Unit]
Description=OMniLeads Prometheus uwsgi exporter (Podman Quadlet)
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
ContainerName=obs-prometheus-uwsgi
Image={{ UWSGI_EXPORTER_IMG }}
Pod=observability.pod
Exec=--stats.uri=http://omlapp-uwsgi-server:9191
PodmanArgs=--cgroups=no-conmon
LogDriver=journald
Label=tier=observability

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
