
# Email configuration
{% if email_backend is defined %}
EMAIL_BACKEND={{ email_backend }}
{% else %}
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
{% endif %}
{% if email_backend is defined and email_backend == "django.core.mail.backends.smtp.EmailBackend" %}
DEFAULT_FROM_EMAIL={{ email_default_from }}
EMAIL_HOST={{ email_host }}
EMAIL_HOST_PASSWORD={{ email_password }}
EMAIL_HOST_USER={{ email_user }}
EMAIL_PORT={{ email_port }}
{% endif %}
{% if email_ssl_certfile is defined %}
EMAIL_SSL_CERTFILE={{ email_ssl_certfile }}
{% endif %}
{% if email_ssl_keyfile is defined %}
EMAIL_SSL_KEYFILE={{ email_ssl_keyfile }}
{% endif %}
{% if email_use_ssl is defined %}
EMAIL_USE_SSL={{ email_use_ssl }}
{% endif %}
{% if email_use_tls is defined %}
EMAIL_USE_TLS={{ email_use_tls }}
{% endif %}

# -------------------------------------------------------------------
{% if scale_uwsgi is defined and scale_uwsgi == true %}
UWSGI_CUSTOM=True
UWSGI_PROCESSES={{ uwsgi_processes }}
UWSGI_THREADS={{ uwsgi_threads }}
UWSGI_LISTEN_QUEUE_SIZE={{ uwsgi_listen_queue_size }}
UWSGI_WORKER_RELOAD_MERCY={{ uwsgi_worker_reload_mercy }}
UWSGI_EVIL_RELOAD_ON_RSS={{ uwsgi_evil_reload_on_rss }}
{% else %}
UWSGI_CUSTOM=false
{% endif %}

{% if custom_cors_allowed_origins is defined %}
CUSTOM_CORS_ALLOWED_ORIGINS={{ custom_cors_allowed_origins }}
CUSTOM_CORS_ALLOW_HEADERS={{ custom_cors_allow_headers }}
{% endif %}

{% if proxy_url is defined %}
http_proxy={{ proxy_url }}
https_proxy={{ proxy_url }}
NO_PROXY=127.0.0.1
{% endif %}

BUCKET_ACCESS_KEY_ID={{ bucket_access_key }}
BUCKET_SECRET_ACCESS_KEY={{ bucket_secret_key }}
BUCKET_DEFAULT_REGION={{ bucket_region }}
BUCKET_NAME={{ bucket_name }}
BUCKET_ENDPOINT={{ bucket_endpoint }}
BUCKET_ENDPOINT_INTERNAL={{ bucket_endpoint_internal }}
CALIFICACION_REAGENDA={{ schedule }}
SECRET_KEY={{ django_secret_key }}
SIP_SECRET_KEY={{ kamailio_webrtc_auth_eph_key }}
DJANGO_HOSTNAME={{ omlapp_uwsgi_container_name }}
DJANGO_ALLOW_ASYNC_UNSAFE="true"
DJANGO_SETTINGS_MODULE={{ django_settings_module }}
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
EPHEMERAL_USER_TTL={{ ECCTL }}
GEARMAN_JOB_SERVERS={{ gearman_host | trim }}:{{ gearman_port }}
GEARMAN_QUEUE_CALL={{ task_call_processor }}
GOOGLE_MAPS_API_KEY={{ google_maps_api_key | default('', true) }}
GOOGLE_MAPS_CENTER='${GOOGLE_MAPS_CENTER}'
INSTALL_PREFIX=/opt/omnileads/
LOGIN_FAILURE_LIMIT={{ LOGIN_FAILURE_LIMIT }}
MONITORFORMAT={{ callrec_format }}
OML_BRANCH={{ APP_IMG }}
OML_COMMIT={{ commit | default('unknown') }}
OML_BUILD_DATE={{ build_date | default('unknown') }}

# Hostnames and IP addresses
DJANGO_ALLOWED_HOSTS={{ fqdn }},{{ omni_ip_lan }},127.0.0.1{% if django_allowed_hosts_extra is defined and (django_allowed_hosts_extra | string | length) > 0 %},{{ django_allowed_hosts_extra }}{% endif %}
DJANGO_CSRF_TRUSTED_ORIGINS=https://{{ fqdn }}{% if django_allowed_hosts_extra is defined and (django_allowed_hosts_extra | string | length) > 0 %}{% for host in django_allowed_hosts_extra.split(',') %},https://{{ host | trim }}{% endfor %}{% endif %}

OMNILEADS_HOSTNAME={{ omni_ip_lan }}

OML_OMNIDIALER_SECRET={{ dialer_password }}
OMNIDIALER_HOST=localhost:1440
PYTHONPATH=/opt/omnileads/ominicontacto

# Database configuration
PGHOST={{ postgres_host  | trim }}
PGDATABASE={{ postgres_database }}
PGPORT={{ postgres_port }}
PGUSER={{ postgres_user }}
PGPASSWORD={{ postgres_password }}
{% if postgres_ha == true %}
PGHOSTHA={{ postgres_ha }}
PGHOSTRO={{ postgres_ro_vip }}
{% endif %}

REDIS_HOSTNAME={{ redis_host | trim }}
SESSION_COOKIE_AGE={{ SCA }}
PRESENCE_LOG_RECONNECT_COOLDOWN_MS={{ PRESENCE_LOG_RECONNECT_COOLDOWN_MS | default(1500) }}
PRESENCE_HEARTBEAT_INTERVAL_SEC={{ PRESENCE_HEARTBEAT_INTERVAL_SEC | default(15) }}
PRESENCE_HEARTBEAT_TIMEOUT_SEC={{ PRESENCE_HEARTBEAT_TIMEOUT_SEC | default(60) }}
PRESENCE_HEARTBEAT_SWEEP_SEC={{ PRESENCE_HEARTBEAT_SWEEP_SEC | default(15) }}
PRESENCE_HEARTBEAT_LOGOUT_RECENT_SEC={{ PRESENCE_HEARTBEAT_LOGOUT_RECENT_SEC | default(90) }}
PRESENCE_HEARTBEAT_GUARD_TTL_SEC={{ PRESENCE_HEARTBEAT_GUARD_TTL_SEC | default(90) }}
TZ={{ TZ }}
UWSGI_PORT={{ uwsgi_port }}
WEBSOCKET_HOST={{ websocket_host  | trim }}
WEBSOCKET_PORT={{ websocket_port }}

KAMAILIO_HOSTNAME={{ kamailio_host | trim }}
KAMAILIO_PORT=10060
