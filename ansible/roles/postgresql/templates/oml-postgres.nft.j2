# Managed by Ansible (role postgresql). Do not edit by hand.
# Allowlist TCP/{{ postgres_port | default(5432) }} on the Postgres host.
# Uses a dedicated table so netavark and fail2ban rulesets stay intact.
destroy table inet oml_postgres

table inet oml_postgres {
  set postgres_clients {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in postgres_nftables_clients %}
      {{ cidr }}{% if not loop.last %},{% endif %}

{% endfor %}
    }
  }

  chain postgres {
    type filter hook prerouting priority -150; policy accept;
    tcp dport {{ postgres_port | default(5432) }} ip saddr @postgres_clients accept
    tcp dport {{ postgres_port | default(5432) }} drop
    meta nfproto ipv6 tcp dport {{ postgres_port | default(5432) }} drop
  }
}
