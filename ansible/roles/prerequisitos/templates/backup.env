TENANT={{ tenant_id }}
---------------------------------------------------------
S3_SSL_DONT_VERIFY={{ backup_bucket_dont_verify_ssl | default(false) }}
S3_ENDPOINT={{ backup_bucket_url }}
S3_BUCKET_NAME={{ backup_bucket_name }}
S3_ACCESS_KEY_ID={{ backup_bucket_access_key }}
S3_SECRET_ACCESS_KEY={{ backup_bucket_secret_key }}
---------------------------------------------------------
SQL_HOST={{ postgres_host  | trim }}
SQL_DATABASE={{ postgres_database }}
SQL_PORT={{ postgres_port }}
SQL_USER={{ postgres_user }}
SQL_PASSWORD={{ postgres_password }}
{% if postgres_ha == true %}
SQL_HOSTHA={{ postgres_ha }}
SQL_HOSTRO={{ postgres_ro_vip }}
{% endif %}
TZ={{ TZ }}