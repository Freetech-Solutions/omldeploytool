# Managed by Ansible (role redis). Do not edit by hand.
# Allowlist TCP/{{ redis_port | default(6379) }} on the Redis host.
# Uses a dedicated table so netavark and fail2ban rulesets stay intact.
destroy table inet oml_redis

table inet oml_redis {
  set redis_clients {
    type ipv4_addr
    flags interval
    elements = {
{% for cidr in redis_nftables_clients %}
      {{ cidr }}{% if not loop.last %},{% endif %}

{% endfor %}
    }
  }

  chain redis {
    type filter hook prerouting priority -150; policy accept;
    tcp dport {{ redis_port | default(6379) }} ip saddr @redis_clients accept
    tcp dport {{ redis_port | default(6379) }} drop
    meta nfproto ipv6 tcp dport {{ redis_port | default(6379) }} drop
  }
}
