ACD_NODES={{ acd_nodes }}
DOMAIN=example.com
IPADDR_PUBLIC={{ omni_ip_wan }}
IPADDR_PRIVATE={{ omni_ip_lan }}
ITSP_NODES={{ itsp_nodes }}
FQDN={{ fqdn }}
RTPENGINE_SOCKET=udp:{{ rtpengine_host  | trim }}:{{ rtpengine_ctl_port | default(22222, true) }}
KAMAILIO_CERTS_LOCATION={{ kamailio_certs_location }}
{% if homer_host is defined %}
HOMER_ENABLE=True
HOMER_HOST={{ homer_host }}
HOMER_PORT={{ homer_port | default(9060) }}
HOMER_CAPTURE_ID={{ homer_kamailio_pstn_capture_id | default(2002) }}
HOMER_NODE_NAME={{ homer_pstn_node_name | default(homer_node_name | default(tenant_id ~ '-pstn', true), true) }}
{% else %}
HOMER_ENABLE=false
{% endif %}
