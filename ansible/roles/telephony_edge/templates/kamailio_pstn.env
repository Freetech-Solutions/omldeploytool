ACD_NODES={{ KAMAILIO_ACD_NODES | default(acd_nodes) }}
ASTERISK_PORT={{ acd_trunk_sip_port | default(5070) }}
ASTERISK_SETID=10
DOMAIN=example.com
IPADDR_PUBLIC={{ omni_ip_wan }}
IPADDR_PRIVATE={{ omni_ip_lan }}
ITSP_NODES={{ itsp_nodes }}
FQDN={{ fqdn }}
RTPENGINE_SOCKET=udp:{{ rtpengine_host  | trim }}:{{ rtpengine_ctl_port | default(22222, true) }}
KAMAILIO_CERTS_LOCATION={{ kamailio_certs_location }}
KAMAILIO_TLS_ENABLE={{ kamailio_tls_enable | default(false) | bool | ternary('true', 'false') }}
KAMAILIO_UDP_PORT={{ kamailio_pstn_port | default(5060) }}
KAMAILIO_PUBLIC_UDP_PORT={{ kamailio_pstn_public_port | default(kamailio_pstn_port | default(5060)) }}
NAT_ENABLE={{ (nat_ip_addr is defined and (nat_ip_addr | string | trim | length) > 0) | ternary('true', 'false') }}
PIKE_ENABLE={{ fail2ban_kamailio_pike | default(true) | bool | ternary('true', 'false') }}
{% if homer_host is defined %}
HOMER_ENABLE=True
HOMER_HOST={{ homer_host }}
HOMER_PORT={{ homer_port | default(9060) }}
HOMER_CAPTURE_ID={{ homer_kamailio_pstn_capture_id | default(2002) }}
HOMER_NODE_NAME={{ homer_pstn_node_name | default(homer_node_name | default(tenant_id ~ '-pstn', true), true) }}
{% else %}
HOMER_ENABLE=false
{% endif %}
