ACD_NET_ADDR={{ acd_host | trim }}
AUTHEPH_SK={{ kamailio_webrtc_auth_eph_key }}
KAMAILIO_HOSTNAME={{ omni_ip_lan }}
KAMAILIO_CERTS_LOCATION={{ kamailio_certs_location }}
REDIS_HOSTNAME={{ redis_host | trim }}
RTPENGINE_HOSTNAME={{ rtpengine_host  | trim }}
SHM_SIZE={{ kamailio_shm_size | default(128) }}
PKG_SIZE={{ kamailio_pkg_size | default(16) }}
TZ={{ TZ }}
KAMAILIO_IFACE={{ kamailio_webrtc_iface }}
{% if homer_host is defined %}
HOMER_ENABLE=True
HOMER_HOST={{ homer_host }}
HOMER_PORT={{ homer_port | default(9060) }}
HOMER_CAPTURE_ID={{ homer_kamailio_webrtc_capture_id | default(2003) }}
HOMER_NODE_NAME={{ homer_webrtc_node_name | default(tenant_id ~ '-webrtc', true) }}
{% else %}
HOMER_ENABLE=false
{% endif %}
