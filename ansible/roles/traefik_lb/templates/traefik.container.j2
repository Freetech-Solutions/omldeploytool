[Unit]
Description=Traefik v3 load balancer (Podman Quadlet)
Documentation=https://doc.traefik.io/traefik/
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Container]
ContainerName=traefik-lb
Image=docker.io/library/traefik:v3.0
EnvironmentFile=/etc/default/traefik.env
PublishPort=80:80
PublishPort=443:443
PublishPort=8080:8080
Volume=/etc/default/traefik.yml:/etc/traefik/traefik.yml:ro,Z
Volume=/etc/default/nginx_backends.yml:/etc/traefik/dynamic/nginx_backends.yml:ro,Z
Exec=--configFile=/etc/traefik/traefik.yml
PodmanArgs=--cgroups=no-conmon
LogDriver=journald

[Service]
Restart=on-failure
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
