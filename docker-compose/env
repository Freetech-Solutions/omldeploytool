# Forced SIP responses by R-URI user-part prefix
# the prefixes listed below are relayed to the PSTN Emulator (PBX))
# When KAMAILIO_PSTN_QA is true, the prefixes listed below are relayed to the PSTN Emulator (PBX).

#    081*  -> 480 Temporarily Unavailable
#    082*  -> 487 Request Terminated
#    083*  -> 488 Not Acceptable Here
#    084*  -> 500 Internal Server Error
#    085*  -> 502 Bad Gateway
#    086*  -> 608 Rejected
#    087*  -> 180 Ringing 45 seconds
#    092*  -> 404 Not Found
#    093*  -> 503 Service Unavailable
#    094*  -> 486 Busy Here
#    095*  -> 603 Decline
#    096*  -> 403 Forbidden
#    097*  -> 405 Method Not Allowed
#    098*  -> 406 Not Acceptable
#    099*  -> 408 Request Timeout
#    otro  -> relay hacia ITSP (comportamiento normal del SBC)

# For numbers relayed to the PSTN Emulator (PBX), the response mode is defined by
# the "mode" set as an env var on the PSTN Emulator (PBX).

# ---default: 100% of the calls are answered.
# ---dial2softphone: 100% of the calls are sent to the testing softphone.
# ---test_dialer: 

PSTN_EMULATOR_MODE=test_dialer

# --- dial2softphone: 100% of the calls are sent to the softphone.
# ---mode_1: 100% answered, play music and transfer with SIP REFER.
# ---mode_2: 100% answered, play music and OML API (80% GESTION_BOT / 20% MUDA_BOT).
# ---mode_3: 25% SIP REFER + GESTION_BOT / 50% 80-20 GESTION_BOT-MUDA_BOT / 25% agenda.
# ---mode_4: 10% SIP REFER + GESTION_BOT / 25% MUDA_BOT / 40% ABANDON_BOT / 25% agenda.
VOICEBOT_CALL_MODE=mode_4

