TENANT_NAME=observability

# OMniLeads stack network
OMNILEADS_NETWORK_NAME=prod-env_omnileads
OMNILEADS_STACK_ENV=observability

PROMETHEUS_IMG=prom/prometheus:v3.0.1
PROMETHEUS_NODE_EXPORTER_IMG=prom/node-exporter:v1.7.0
CADVISOR_IMG=gcr.io/cadvisor/cadvisor:latest
REDIS_EXPORTER_IMG=oliver006/redis_exporter:latest
POSTGRES_EXPORTER_IMG=prometheuscommunity/postgres-exporter:latest
PROMTAIL_IMG=grafana/promtail
GEARMAN_EXPORTER_IMG=gearmanexporter/gearman-exporter:v0.5.0
UWSGI_EXPORTER_IMG=timonwong/uwsgi-exporter:v1.3.0

REDIS_HOSTNAME=${OMNILEADS_STACK_ENV}-redis-1
REDIS_PORT=6379

PGHOST=${OMNILEADS_STACK_ENV}-postgresql-1 

POSTGRES_HOSTNAME=${OMNILEADS_STACK_ENV}-postgresql-1
POSTGRES_DB=omnileads
POSTGRES_PORT=5432
POSTGRES_USER=omnileads
POSTGRES_PASSWORD=admin123

TZ=America/Argentina/Cordoba