# Copiar a ansible/instances/<tenant>/backend.hcl (la carpeta instances/ no se commitea).
# Puede ser el mismo archivo que usa terraform/digitalocean: la key del state
# vive en versions.tf y es terraform/vultr/terraform.tfstate.
# bucket es el Space de ESE tenant. El endpoint usa la region del Space.
# No pongas aca la access key: export AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY.

bucket = "nombre-del-space"
endpoints = {
  s3 = "https://sfo3.digitaloceanspaces.com"
}
